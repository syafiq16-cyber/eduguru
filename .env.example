# ============================================
# EduGuru Environment Configuration Template
# ============================================
# Salin file ini menjadi .env di root atau di folder backend/

# --- SERVER CONFIG ---
PORT=3002
NODE_ENV=production

# --- JWT AUTHENTICATION ---
# Generate key aman: openssl rand -base64 32
JWT_SECRET=ganti-dengan-secret-key-acak-anda-untuk-keamanan

# --- DATABASE POSTGRESQL ---
# Disesuaikan dengan database yang dibuat di aaPanel
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduguru
DB_USER=eduguru_user
DB_PASSWORD=password_database_anda
DB_SSL=false

# --- GOOGLE GEMINI AI (OPSIONAL) ---
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- GOOGLE OAUTH (OPSIONAL) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
